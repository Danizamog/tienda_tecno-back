# =======================================
# SECRETS — generar valores únicos por entorno
# Comando: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA reutilizar el mismo valor entre dev y prod, ni commitear este archivo con valores reales.
# =======================================
SECRET_KEY=replace-with-32-byte-hex
JWT_SECRET=replace-with-32-byte-hex

# =======================================
# URLS
# =======================================
BACKEND_URL=http://localhost:9000
FRONTEND_URLS=http://localhost:5173,http://localhost:3000

# =======================================
# OAUTH 2.0 - GOOGLE
# Obtener en: https://console.cloud.google.com/apis/credentials
# =======================================
OAUTH_PROVIDER=google
OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# =======================================
# POCKETBASE
# =======================================
POCKETBASE_URL=https://your-pocketbase-host
POCKETBASE_AUTH_IDENTITY=admin@example.com
POCKETBASE_AUTH_PASSWORD=replace-with-strong-password
POCKETBASE_TIMEOUT_SECONDS=30

# Headers opcionales para scripts de migración
POCKETBASE_HTTP_USER_AGENT=Mozilla/5.0
POCKETBASE_HTTP_ORIGIN=https://your-pocketbase-host
POCKETBASE_HTTP_REFERER=https://your-pocketbase-host/
